# Dockerfile.simulation
# Simulates the Jetson Nano environment (Python 3.6 target, using 3.9 for x86 compatibility)
# Current version is for testing refactoring, not fully simulating the jetson environment

FROM python:3.9-slim-bullseye

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgl1-mesa-glx \
    libglib2.0-0 \
    v4l-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY src /app/src
COPY main.py /app/main.py
COPY web_main.py /app/web_main.py
COPY models /app/models
COPY requirements.txt /app/requirements.txt

# Install python dependencies
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

EXPOSE 5000

# Default entrypoint
ENTRYPOINT ["python", "main.py", "--device", "cpu"]
